+/* A page is one physical label. All pages of a run are printed inside a SINGLE
+   job: every page but the last is finalized with the chain command (print, no
+   feed), so the tape is fed to the cutter only once, at the end. That is what
+   makes a batch cost one ~25mm blank leader instead of one per label, while
+   --precut still cuts the pages apart. Pages are separated by --page. */
+typedef struct page {
+	gdImage *im;
+	struct page *next;
+} page_t;
