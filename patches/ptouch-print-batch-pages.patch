+/* Close off the accumulated image as one page. A NULL image (two --page in a
+   row, or a trailing --page) is not a page and is silently ignored. */
+void add_page(gdImage *im)
+{
+	if (!im) {
+		return;
+	}
+	page_t *new_page = (page_t*)malloc(sizeof(page_t));
+	if (!new_page) {
+		printf(_("out of memory\n"));
+		exit(1);
+	}
+	new_page->im = im;
+	new_page->next = NULL;
+	if (!last_page) {
+		pages = last_page = new_page;
+	} else {
+		last_page->next = new_page;
+		last_page = new_page;
+	}
+	++page_count;
+}
